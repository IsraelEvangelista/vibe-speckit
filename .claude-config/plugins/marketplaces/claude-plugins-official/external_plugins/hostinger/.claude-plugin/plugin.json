{
  "name": "hostinger",
  "version": "1.0.0",
  "description": "Hostinger API MCP Server - Gerencie hospedagem, dominios e servidores VPS via API",
  "provider": "hostinger",
  "category": "hosting",
  "keywords": ["hostinger", "hosting", "vps", "domain", "api"],
  "mcp": {
    "servers": {
      "hostinger-mcp": {
        "type": "stdio",
        "command": "npx",
        "args": ["hostinger-api-mcp@latest"],
        "env": {
          "API_TOKEN": "${API_TOKEN}"
        }
      }
    }
  }
}
