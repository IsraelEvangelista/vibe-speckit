{
  "mcpServers": {
    "byterover-mcp": {
      "url": "https://mcp.byterover.dev/mcp?machineId=1f09f210-2932-6420-a075-95c7a6d3edf5"
    },
    "perplexity-deep": {
      "command": "npx",
      "args": ["perplexity-mcp"],
      "env": {
        "PERPLEXITY_API_KEY": "YOUR_PERPLEXITY_API_KEY",
        "PERPLEXITY_MODEL": "sonar-deep-research",
        "MCP_TOOL_DESCRIPTION": "Use para pesquisa aprofundada com múltiplas fontes, comparação extensa e síntese robusta."
      }
    },
    "perplexity-reasoning": {
      "command": "npx",
      "args": ["perplexity-mcp"],
      "env": {
        "PERPLEXITY_API_KEY": "YOUR_PERPLEXITY_API_KEY",
        "PERPLEXITY_MODEL": "sonar-reasoning-pro",
        "MCP_TOOL_DESCRIPTION": "Use para análise técnica com trade-offs, arquitetura, depuração complexa e decisões de implementação."
      }
    },
    "perplexity-fast": {
      "command": "npx",
      "args": ["perplexity-mcp"],
      "env": {
        "PERPLEXITY_API_KEY": "YOUR_PERPLEXITY_API_KEY",
        "PERPLEXITY_MODEL": "sonar",
        "MCP_TOOL_DESCRIPTION": "Use para perguntas objetivas e rápidas, checagens factuais e baixo custo. Evite para análises longas."
      }
    },
    "testsprite": {
      "command": "npx",
      "args": ["@testsprite/testsprite-mcp@latest"],
      "env": {
        "API_KEY": "YOUR_TESTSPRITE_API_KEY"
      }
    },
    "Chrome DevTools MCP": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"],
      "env": {}
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"],
      "env": {
        "DEFAULT_MINIMUM_TOKENS": "10000"
      }
    },
    "stitch": {
      "url": "https://stitch.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "YOUR_GOOGLE_API_KEY"
      }
    },
    "zai-mcp-server": {
      "command": "npx",
      "args": ["-y", "@z_ai/mcp-server"],
      "env": {
        "Z_AI_API_KEY": "YOUR_Z_AI_API_KEY",
        "Z_AI_MODE": "ZAI"
      }
    },
    "web-search-prime": {
      "url": "https://api.z.ai/api/mcp/web_search_prime/mcp",
      "headers": {
        "Authorization": "YOUR_Z_AI_API_KEY"
      }
    },
    "web-reader": {
      "url": "https://api.z.ai/api/mcp/web_reader/mcp",
      "headers": {
        "Authorization": "YOUR_Z_AI_API_KEY"
      }
    },
    "zread": {
      "url": "https://api.z.ai/api/mcp/zread/mcp",
      "headers": {
        "Authorization": "YOUR_Z_AI_API_KEY"
      }
    },
    "ai-context": {
      "command": "npx",
      "args": ["@ai-coders/context", "mcp"]
    }
  }
}
